# Copy to .env.local for local dev. Set the same vars in Vercel > Project > Settings > Environment Variables.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-key>
# Layer 2 background push (Step 1): `npx web-push generate-vapid-keys` then paste public key here.
# Without this, foreground in-app + device popup still works; background push stays disabled.
VITE_VAPID_PUBLIC_KEY=
